NODE_ENV=development

# Contracts
# Never commit a real private key.
PRIVATE_KEY=
VRF_SUB_ID_MAINNET=0
VAULT_FUND_ETH_MAINNET=
LUCKY_DRAW_FUND_ETH_MAINNET=
VAULT_CONTRACT_NAME=GameVaultV2
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ALLOW_MAINNET_DEPLOY=false
ALLOW_CREATE_MAINNET_VRF_SUB=false
ALLOW_ZERO_MAINNET_VAULT=false

# Frontend
NEXT_PUBLIC_DEFAULT_CHAIN=baseMainnet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=https://game-contracts-production.up.railway.app
BACKEND_URL=https://game-contracts-production.up.railway.app
# Optional RPC overrides. Leave empty to use official Base RPC plus public fallback.
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=
BASE_MAINNET_BACKEND_RPC_URL=
# Optional server-only Ethereum mainnet RPC for ENS fallback in /api/basename.
MAINNET_RPC_URL=
NEXT_PUBLIC_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ADMIN_ADDRESSES=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BET_PRESETS_ETH=0.000115,0.00023,0.0005

# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
BACKEND_ADMIN_ADDRESSES=0x0000000000000000000000000000000000000000

# Base RPC fallbacks are built into packages/shared/src/config/networks.ts
# and packages/contracts/hardhat.config.ts. Production should still use
# provider-backed RPC env vars for higher rate limits.
